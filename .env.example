# Copy this file to .env and fill in your values
# Never commit .env to source control

# Shared JWT secret — used by all services to sign/validate tokens
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Internal API key — used by services to call the Audit Service
INTERNAL_API_KEY=internal-secret-key

# Build parallelism — set to 1 on low-bandwidth servers (e.g. OCI VM) to prevent
# all 5 services downloading Maven dependencies simultaneously, which causes
# rate limiting and SSL failures. Remove or increase once images are cached.
COMPOSE_PARALLEL_LIMIT=1
