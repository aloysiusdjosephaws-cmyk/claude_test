{
  "version": "2.0.0",
  "tasks": [

    // ─── Individual backend service tasks ────────────────────────────────────

    {
      "label": "Start: Audit Service",
      "type": "shell",
      "command": "mvn spring-boot:run -Dspring-boot.run.profiles=local",
      "options": {
        "cwd": "${workspaceFolder}/services/audit-service"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting AuditApplication",
          "endsPattern": "Started AuditApplication"
        }
      },
      "presentation": { "group": "backends", "panel": "dedicated", "reveal": "always" }
    },

    {
      "label": "Start: User Management Service",
      "type": "shell",
      "command": "mvn spring-boot:run -Dspring-boot.run.profiles=local",
      "options": {
        "cwd": "${workspaceFolder}/services/user-management-service"
      },
      "dependsOn": ["Start: Audit Service"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting UserManagementApplication",
          "endsPattern": "Started UserManagementApplication"
        }
      },
      "presentation": { "group": "backends", "panel": "dedicated", "reveal": "always" }
    },

    {
      "label": "Start: Application Management Service",
      "type": "shell",
      "command": "mvn spring-boot:run -Dspring-boot.run.profiles=local",
      "options": {
        "cwd": "${workspaceFolder}/services/application-management-service"
      },
      "dependsOn": ["Start: User Management Service"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ApplicationManagementApplication",
          "endsPattern": "Started ApplicationManagementApplication"
        }
      },
      "presentation": { "group": "backends", "panel": "dedicated", "reveal": "always" }
    },

    {
      "label": "Start: Document Management Service",
      "type": "shell",
      "command": "mvn spring-boot:run -Dspring-boot.run.profiles=local",
      "options": {
        "cwd": "${workspaceFolder}/services/document-management-service"
      },
      "dependsOn": ["Start: Application Management Service"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting DocumentManagementApplication",
          "endsPattern": "Started DocumentManagementApplication"
        }
      },
      "presentation": { "group": "backends", "panel": "dedicated", "reveal": "always" }
    },

    {
      "label": "Start: Angular Frontend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building...",
          "endsPattern": "compiled successfully"
        }
      },
      "presentation": { "group": "frontend", "panel": "dedicated", "reveal": "always" }
    },

    // ─── Compound: start everything ───────────────────────────────────────────

    {
      "label": "Start All Services",
      "dependsOn": [
        "Start: Audit Service",
        "Start: User Management Service",
        "Start: Application Management Service",
        "Start: Document Management Service",
        "Start: Angular Frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },

    // ─── npm install ──────────────────────────────────────────────────────────

    {
      "label": "Install: Frontend Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ─── Maven install (compile check) ────────────────────────────────────────

    {
      "label": "Build: All Backend Services",
      "type": "shell",
      "command": "for d in audit-service user-management-service application-management-service document-management-service; do echo \"=== Building $d ===\"; mvn -f services/$d/pom.xml package -DskipTests -q; done",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$javac"]
    }

  ]
}
