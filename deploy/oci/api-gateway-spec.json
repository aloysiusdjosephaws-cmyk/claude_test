{
  "requestPolicies": {
    "cors": {
      "allowedOrigins": [
        "https://objectstorage.YOUR_REGION.oraclecloud.com",
        "https://YOUR_BUCKET_NAME.objectstorage.YOUR_REGION.oci.customer-oci.com"
      ],
      "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allowedHeaders": ["Content-Type", "Authorization", "X-Requested-With"],
      "exposedHeaders": ["Content-Disposition"],
      "isAllowCredentialsEnabled": false,
      "maxAgeInSeconds": 3600
    }
  },
  "routes": [
    {
      "path": "/files",
      "methods": ["GET"],
      "backend": {
        "type": "HTTP_BACKEND",
        "url": "http://FILE_SERVICE_LB_IP:8080/files"
      }
    },
    {
      "path": "/files/upload",
      "methods": ["POST"],
      "backend": {
        "type": "HTTP_BACKEND",
        "url": "http://FILE_SERVICE_LB_IP:8080/files/upload"
      }
    },
    {
      "path": "/files/download/{id}",
      "methods": ["GET"],
      "backend": {
        "type": "HTTP_BACKEND",
        "url": "http://FILE_SERVICE_LB_IP:8080/files/download/${request.path[id]}"
      }
    },
    {
      "path": "/actuator/health",
      "methods": ["GET"],
      "backend": {
        "type": "HTTP_BACKEND",
        "url": "http://FILE_SERVICE_LB_IP:8080/actuator/health"
      }
    }
  ]
}
